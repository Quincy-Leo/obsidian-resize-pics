{
  "name": "resize-pics",
  "version": "0.2.1",
  "private": true,
  "description": "Rescale images in a note so that text baked into them matches the body font size.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --external:obsidian --format=cjs --platform=browser --target=es2018 --outfile=main.js",
    "check": "npm run build && node --check main.js",
    "test": "node --test ut/*.test.js"
  },
  "dependencies": {
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "esbuild": "0.28.0"
  }
}
